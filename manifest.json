{
  "manifest_version": 3,
  "name": "Keep Tab Active",
  "version": "1.7.0",
  "description": "Right-click to stop Memory Saver from discarding this tab. Nothing else.",
  "homepage_url": "https://github.com/Comprehensive-Jason/keep-tab-active",
  "permissions": ["contextMenus", "activeTab", "scripting", "favicon"],
  "optional_host_permissions": ["<all_urls>"],
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Keep this tab active (click to toggle)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "toggle-keep-active": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Toggle: keep this tab active"
    }
  }
}
